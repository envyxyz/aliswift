{
  "manifest_version": 3,
  "name": "AliSwift",
  "version": "0.5.0",
  "minimum_chrome_version": "117",
  "key": "***REMOVED: compromised key, rotated in 0.6.0***",
  "description": "Save AliExpress products to Google Sheets in one click. Scrapes title, price and shipping, then adds your sell price.",
  "homepage_url": "https://github.com/envyxyz/aliswift",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://sheets.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/item/*",
        "https://*.aliexpress.us/item/*",
        "https://*.aliexpress.com/*/buyNow*",
        "https://*.aliexpress.us/*/buyNow*"
      ],
      "js": ["lib/shared.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "oauth2": {
    "client_id": "969152943077-1qkbqj3sdfoehcuqog2bns9mt5a24l0q.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
