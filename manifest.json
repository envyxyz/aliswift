{
  "manifest_version": 3,
  "name": "AliSwift",
  "version": "0.9.0",
  "minimum_chrome_version": "119",
  "key": "",
  "description": "Save AliExpress products to Google Sheets in one click. Scrapes title, price and shipping, then adds your sell price.",
  "homepage_url": "https://github.com/envyxyz/aliswift",
  "permissions": ["storage", "identity", "alarms"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["https://api.groq.com/*", "https://openrouter.ai/*"],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/drive/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.alicdn.com/*",
    "https://*.aliexpress-media.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/item/*",
        "https://*.aliexpress.us/item/*",
        "https://*.aliexpress.com/*/buyNow*",
        "https://*.aliexpress.us/*/buyNow*"
      ],
      "js": ["lib/shared.js", "lib/errors.js", "content.js"],
      "css": ["content.css"]
    },
    {
      "matches": [
        "https://www.ebay.com/lstng*",
        "https://www.ebay.co.uk/lstng*",
        "https://www.ebay.de/lstng*",
        "https://www.ebay.com.au/lstng*",
        "https://www.ebay.ca/lstng*",
        "https://www.ebay.com/sl/*",
        "https://www.ebay.co.uk/sl/*",
        "https://www.ebay.de/sl/*",
        "https://www.ebay.com.au/sl/*",
        "https://www.ebay.ca/sl/*"
      ],
      "js": ["lib/panel.js", "lib/errors.js", "lib/ebayform.js", "content-ebay.js"]
    },
    {
      "matches": [
        "https://www.ebay.com/sh/ord*",
        "https://www.ebay.co.uk/sh/ord*",
        "https://www.ebay.de/sh/ord*",
        "https://www.ebay.com.au/sh/ord*",
        "https://www.ebay.ca/sh/ord*"
      ],
      "js": ["lib/panel.js", "lib/errors.js", "lib/orders.js", "content-orders.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/ui.css", "ebay.css"],
      "matches": ["https://www.ebay.com/*", "https://www.ebay.co.uk/*", "https://www.ebay.de/*", "https://www.ebay.com.au/*", "https://www.ebay.ca/*"],
      "use_dynamic_url": true
    }
  ],
  "oauth2": {
    "client_id": "969152943077-gu45dvs7m8focodjipogbr3hmpfs52vu.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.metadata.readonly"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
