# Keys for the live provider check (node scripts/live.mjs). Copy to .env and fill in; .env is gitignored.
# Leave a key empty to skip that provider. Never put real keys in this file.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: test a model other than the default in lib/ai.js.
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
